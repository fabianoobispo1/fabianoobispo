# .env do Terminal Server na VPS (/opt/terminal-server/.env, chmod 600).
# NUNCA commite valores reais.

# Obrigatórias
TERMINAL_TOKEN_SECRET=          # mín. 32 chars; igual ao do Next.js
ALLOWED_ORIGINS=https://fabianoobispo.com.br   # vírgula para várias
TERMINAL_AUTHORIZED_EMAIL=      # defesa extra: e-mail do token precisa bater
TERMINAL_PRIVATE_KEY=           # node scripts/gen-terminal-keys.mjs (par da NEXT_PUBLIC_TERMINAL_PUBLIC_KEY)

# Rede / TLS (em produção um dos dois é obrigatório)
PORT=3002
# a) TLS no próprio container:
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem
# b) atrás de reverse proxy com wss (porta publicada só em 127.0.0.1):
ALLOW_INSECURE=1
TRUST_PROXY=1                   # usa X-Forwarded-For nos logs

# Limites (opcionais)
# MAX_CONNECTIONS=10
# MAX_CONNECTIONS_PER_USER=5
# MAX_PAYLOAD_BYTES=262144
# MAX_CHANNELS_PER_CONNECTION=8   # terminais por WebSocket (sshd MaxSessions = 10)
# ALLOWED_SSH_HOSTS=167.86.71.211,meu-servidor.com   # vazio = qualquer host

# Credencial padrão (opcional): usada quando nenhuma conexão salva é escolhida
# SSH_HOST=
# SSH_PORT=22
# SSH_USER=
# SSH_PASSWORD=
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# SSH_PRIVATE_KEY_PASSPHRASE=
# SSH_HOST_FINGERPRINT=SHA256:...   # fixa a host key: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
# Conexões salvas fixam a host key sozinhas na 1ª conexão (TOFU, guardada no Convex).

# Sessões persistentes: instale tmux no HOST de destino (apt install tmux).
# Sem tmux o terminal funciona como shell comum, sem persistência.
