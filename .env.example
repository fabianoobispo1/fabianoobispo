# Copie para .env.local e preencha. NUNCA commite valores reais.
# Variáveis marcadas [Convex] vão no deployment do Convex:
#   npx convex env set NOME valor          (dev)
#   npx convex env set NOME valor --prod   (produção)

# ---------------------------------------------------------------- Convex
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
CONVEX_DEPLOYMENT=dev:<deployment-name>

# ------------------------------------------------- Auth NextAuth → Convex
# Gere com: node scripts/gen-convex-auth-keys.mjs
CONVEX_AUTH_ISSUER=https://fabianoobispo.com.br        # também [Convex]
CONVEX_AUTH_KID=
CONVEX_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# [Convex] CONVEX_AUTH_JWKS=data:text/plain;charset=utf-8;base64,...

# ---------------------------------------------------------------- NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://localhost:3000
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------- Labs [Convex], opcionais
# VPS_API_URL=
# VPS_API_KEY=

# ------------------------------------------------- Mega-Sena [Convex], opcionais
# SENDCLOUD_API_KEY=
# MEGASENA_ALERTA_EMAIL=
# MEGASENA_LIMIAR_ALERTA=
